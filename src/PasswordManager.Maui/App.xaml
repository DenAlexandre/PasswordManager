<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:PasswordManager.Maui"
             xmlns:views="clr-namespace:PasswordManager.Maui.Views"
             x:Class="PasswordManager.Maui.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <views:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <views:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />
            <views:IndentToThicknessConverter x:Key="IndentToThicknessConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
