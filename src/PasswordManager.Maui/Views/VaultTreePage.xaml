<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PasswordManager.Maui.ViewModels"
             x:Class="PasswordManager.Maui.Views.VaultTreePage"
             x:DataType="vm:VaultTreeViewModel"
             Title="Groupes de sites">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Déconnexion" Command="{Binding LogoutCommand}" />
    </ContentPage.ToolbarItems>
    <Grid RowDefinitions="Auto,*">
        <Label Grid.Row="0" Text="{Binding ErrorMessage}" TextColor="Red" Padding="16,8"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />
        <RefreshView Grid.Row="1" Command="{Binding LoadCommand}" IsRefreshing="{Binding IsBusy}">
            <CollectionView ItemsSource="{Binding Rows}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:VaultTreeRow">
                        <Grid Padding="{Binding Indent, Converter={StaticResource IndentToThicknessConverter}}"
                              RowDefinitions="Auto,Auto"
                              MinimumHeightRequest="44">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:VaultTreeViewModel}}, Path=TapRowCommand}"
                                    CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>

                            <Grid Grid.Row="0" ColumnDefinitions="20,*,Auto,Auto,Auto,Auto" Padding="0,6">
                                <Label Grid.Column="0" Text="{Binding Chevron}" FontSize="12" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding Name}" FontAttributes="{Binding RowFontAttributes}" VerticalOptions="Center" />
                                <Label Grid.Column="2" Text="{Binding Subtitle}" TextColor="Gray" FontSize="12" Margin="8,0" VerticalOptions="Center"
                                       IsVisible="{Binding IsEntry, Converter={StaticResource InvertedBoolConverter}}" />
                                <Button Grid.Column="3" Text="✎" Padding="8,0" IsVisible="{Binding CanManageNode}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:VaultTreeViewModel}}, Path=EditNodeCommand}"
                                        CommandParameter="{Binding .}" />
                                <Button Grid.Column="4" Text="🗑" Padding="8,0" IsVisible="{Binding CanManageNode}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:VaultTreeViewModel}}, Path=DeleteNodeCommand}"
                                        CommandParameter="{Binding .}" />
                                <Button Grid.Column="5" Text="+" Padding="8,0" IsVisible="{Binding CanAddChild}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:VaultTreeViewModel}}, Path=AddCommand}"
                                        CommandParameter="{Binding .}" />
                            </Grid>

                            <Grid Grid.Row="1" ColumnDefinitions="20,*,Auto,Auto,Auto" IsVisible="{Binding IsEntry}" Padding="0,0,0,6">
                                <Label Grid.Column="1" Text="{Binding Subtitle}" FontSize="13" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding MaskedPassword}" FontFamily="Courier" FontSize="12" TextColor="Gray"
                                       Margin="0,18,0,0" VerticalOptions="Center" />
                                <Button Grid.Column="2" Text="👁" Padding="8,0"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:VaultTreeViewModel}}, Path=ToggleRevealCommand}"
                                        CommandParameter="{Binding .}" />
                                <Button Grid.Column="3" Text="Copier" Padding="8,0"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:VaultTreeViewModel}}, Path=CopyPasswordCommand}"
                                        CommandParameter="{Binding .}" />
                                <Button Grid.Column="4" Text="🗑" Padding="8,0" IsVisible="{Binding CanWrite}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:VaultTreeViewModel}}, Path=DeleteEntryCommand}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
