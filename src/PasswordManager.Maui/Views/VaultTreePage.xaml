<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PasswordManager.Maui.ViewModels"
             x:Class="PasswordManager.Maui.Views.VaultTreePage"
             x:DataType="vm:VaultTreeViewModel"
             Title="Groupes de sites">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Admin" Command="{Binding OpenAdminCommand}" IsEnabled="{Binding IsAdmin}" />
        <ToolbarItem Text="Déconnexion" Command="{Binding LogoutCommand}" />
    </ContentPage.ToolbarItems>
    <Grid RowDefinitions="Auto,*">
        <Label Grid.Row="0" Text="{Binding ErrorMessage}" TextColor="Red" Padding="16,8"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />
        <RefreshView Grid.Row="1" Command="{Binding LoadCommand}" IsRefreshing="{Binding IsBusy}">
            <CollectionView ItemsSource="{Binding Rows}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:VaultTreeRow">
                        <Grid Padding="{Binding Indent, Converter={StaticResource IndentToThicknessConverter}}"
                              ColumnDefinitions="20,*,Auto,Auto"
                              MinimumHeightRequest="44">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:VaultTreeViewModel}}, Path=TapRowCommand}"
                                    CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0" Text="{Binding Chevron}" FontSize="12" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding Name}" FontAttributes="{Binding RowFontAttributes}" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="{Binding Subtitle}" TextColor="Gray" FontSize="12" Margin="8,0" VerticalOptions="Center" />
                            <Button Grid.Column="3" Text="+" Padding="8,0" IsVisible="{Binding CanWrite}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:VaultTreeViewModel}}, Path=AddSiteCommand}"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
