<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PasswordManager.Maui.Views.RegisterPage"
             Title="Créer un compte">
    <VerticalStackLayout Padding="24" Spacing="16" VerticalOptions="Center">
        <Label Text="Créer un compte" FontSize="24" HorizontalOptions="Center" />
        <Entry Placeholder="Email" Text="{Binding Email}" Keyboard="Email"
               ReturnType="Next" />
        <Grid ColumnDefinitions="*,Auto">
            <Entry Grid.Column="0" Placeholder="Mot de passe (8 caractères minimum)" Text="{Binding Password}"
                   IsPassword="{Binding IsPasswordVisible, Converter={StaticResource InvertedBoolConverter}}" />
            <Button Grid.Column="1" Text="👁" Padding="8,0" Command="{Binding TogglePasswordVisibleCommand}" />
        </Grid>
        <Entry Placeholder="Confirmer le mot de passe" Text="{Binding ConfirmPassword}"
               IsPassword="{Binding IsPasswordVisible, Converter={StaticResource InvertedBoolConverter}}"
               ReturnType="Go" ReturnCommand="{Binding RegisterCommand}" />
        <Button Text="Créer mon compte" Command="{Binding RegisterCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        <Label Text="{Binding ErrorMessage}" TextColor="Red" IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />
    </VerticalStackLayout>
</ContentPage>
