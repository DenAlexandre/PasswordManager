<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PasswordManager.Maui.ViewModels"
             x:Class="PasswordManager.Maui.Views.CredentialsPage"
             x:DataType="vm:CredentialsViewModel"
             Title="{Binding SiteName}">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="+" Command="{Binding AddCredentialCommand}" IsEnabled="{Binding CanWrite}" />
    </ContentPage.ToolbarItems>
    <Grid RowDefinitions="Auto,*">
        <Label Grid.Row="0" Text="{Binding ErrorMessage}" TextColor="Red" Padding="16,8"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />
        <RefreshView Grid.Row="1" Command="{Binding LoadCommand}" IsRefreshing="{Binding IsBusy}">
            <CollectionView ItemsSource="{Binding Credentials}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:CredentialItem">
                        <VerticalStackLayout Padding="16,12" Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="{Binding Label}" FontSize="16" FontAttributes="Bold" />
                                <Button Grid.Column="1" Text="✎" Padding="8,0"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CredentialsViewModel}}, Path=EditCredentialCommand}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                            <Label Text="{Binding Username}" FontSize="14" />
                            <Label Text="{Binding Url}" FontSize="12" TextColor="Gray"
                                   IsVisible="{Binding Url, Converter={StaticResource StringNotEmptyConverter}}" />
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <Label Grid.Column="0" Text="{Binding MaskedPassword}" FontFamily="Courier" VerticalOptions="Center" />
                                <Button Grid.Column="1" Text="👁" Padding="8,0"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CredentialsViewModel}}, Path=ToggleRevealCommand}"
                                        CommandParameter="{Binding .}" />
                                <Button Grid.Column="2" Text="Copier" Padding="8,0"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CredentialsViewModel}}, Path=CopyPasswordCommand}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
