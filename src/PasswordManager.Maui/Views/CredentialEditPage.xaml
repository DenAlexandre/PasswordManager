<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PasswordManager.Maui.ViewModels"
             x:Class="PasswordManager.Maui.Views.CredentialEditPage"
             x:DataType="vm:CredentialEditViewModel"
             Title="{Binding Title}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">
            <Label Text="Libellé" FontSize="12" TextColor="Gray" />
            <Entry Text="{Binding Label}" Placeholder="ex: Accès FTP, Admin panel..." />

            <Label Text="Identifiant" FontSize="12" TextColor="Gray" />
            <Entry Text="{Binding Username}" />

            <Label Text="Mot de passe" FontSize="12" TextColor="Gray" />
            <Grid ColumnDefinitions="*,Auto">
                <Entry Grid.Column="0" Text="{Binding Password}" IsPassword="{Binding IsPasswordVisible, Converter={StaticResource InvertedBoolConverter}}" />
                <Button Grid.Column="1" Text="👁" Padding="8,0" Command="{Binding TogglePasswordVisibleCommand}" />
            </Grid>

            <Label Text="URL" FontSize="12" TextColor="Gray" />
            <Entry Text="{Binding Url}" Keyboard="Url" Placeholder="https://..." />

            <Label Text="Notes" FontSize="12" TextColor="Gray" />
            <Editor Text="{Binding Notes}" HeightRequest="100" AutoSize="TextChanges" />

            <Label Text="{Binding ErrorMessage}" TextColor="Red"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,10,0,0">
                <Button Grid.Column="0" Text="Annuler" Command="{Binding CancelCommand}" />
                <Button Grid.Column="1" Text="Enregistrer" Command="{Binding SaveCommand}" />
            </Grid>
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
