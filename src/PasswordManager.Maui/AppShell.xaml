<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PasswordManager.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:PasswordManager.Maui.Views"
    Shell.NavBarIsVisible="True"
    Title="Password Manager">

    <ShellContent
        Title="Connexion"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="LoginPage"
        Shell.FlyoutBehavior="Disabled" />

    <FlyoutItem Title="Coffre" Route="VaultSection">
        <ShellContent ContentTemplate="{DataTemplate views:VaultTreePage}" Route="VaultTreePage" />
    </FlyoutItem>

    <FlyoutItem x:Name="UsersFlyoutItem" Title="Gestion des utilisateurs" Route="AdminUsersSection" IsVisible="False">
        <ShellContent ContentTemplate="{DataTemplate views:AdminUsersPage}" Route="AdminUsersPage" />
    </FlyoutItem>

</Shell>
