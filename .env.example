POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=passwordmanager
JWT_SECRET=change-me-to-a-long-random-string
API_PORT=8080

# Local dev only - leave unset (defaults to Production) for the production Portainer stack, which
# builds from this same docker-compose.yml. Development enables a dev-only log of the
# email-verification code (see AuthController.SendVerificationEmailAsync) for testing without SMTP.
ASPNETCORE_ENVIRONMENT=Development

# Used to send the email-verification code for self-registration (AuthController.Register).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=noreply@example.com
SMTP_PASSWORD=change-me
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=Password Manager
